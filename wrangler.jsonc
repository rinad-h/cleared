{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Generic template: keep the <placeholders>. Your subdomain and D1 id go in
  // cleared.config.json (git-ignored); deploy scripts render them into
  // wrangler.deploy.jsonc (docs/setup-and-deploy.md §7). `npm run check` fails
  // if this file ever holds real values. No secrets here either: those are Worker secrets.
  // One deployment only: there is no staging environment.
  "name": "cleared",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "secrets": { "required": ["BETTER_AUTH_SECRET"] },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_BASE_URL": "https://cleared.<your-subdomain>.workers.dev",
    "BETTER_AUTH_URL": "https://cleared.<your-subdomain>.workers.dev"
  },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "cleared" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "cleared", "database_id": "<database-id>", "migrations_dir": "drizzle" }
  ],
  "ratelimits": [
    { "name": "RL_ACTIONS", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ]
}

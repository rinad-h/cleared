# Local development variables for `npm run dev` / `npm run preview`.
# Copy to .dev.vars (git-ignored) and fill in. Never put secrets in .env* files:
# OpenNext can embed .env* values into the deployed bundle.

# Override the production values from wrangler.jsonc for local work.
ENVIRONMENT=development
PUBLIC_BASE_URL=http://localhost:3000
# Use http://localhost:8787 for both URLs while running `npm run preview`.
BETTER_AUTH_URL=http://localhost:3000

# Secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me

{
  "name": "cleared",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build --webpack",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "check": "node scripts/check-bundle.mjs --repo && npm run lint && npm run typecheck && node scripts/cf-typegen.mjs --check && npm test && npm run build:worker && node scripts/check-bundle.mjs",
    "config:render": "node scripts/render-wrangler.mjs",
    "deploy": "bash scripts/deploy.sh",
    "deploy:first": "bash scripts/deploy.sh --first",
    "remote": "node scripts/render-wrangler.mjs && wrangler --config wrangler.deploy.jsonc",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run && node --test \"tests/scripts/*.test.mjs\"",
    "test:e2e": "bash tests/e2e/run.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "node scripts/render-wrangler.mjs && wrangler d1 migrations apply DB --remote --config wrangler.deploy.jsonc",
    "db:seed": "tsx scripts/seed.ts",
    "cf-typegen": "node scripts/cf-typegen.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.18",
    "better-auth": "1.7.27",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vitest-plugin": "1.9.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "happy-dom": "21.0.4",
    "postcss": "8.5.33",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.166.0"
  },
  "overrides": {
    "vitest": "4.1.12"
  }
}
